{
  "name": "dsh-balance-monitor",
  "version": "1.0.7",
  "description": "DSH 余额监控插件：在侧边栏底部（设置按钮上方）用金币/钱包图标实时显示 DeepSeek 账户余额，余额变化时数字滚轮动画，并提供「设置 → 余额监控」页面（余额明细、趋势曲线、参数、诊断）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/publishable.mjs && node test/host-smoke.mjs && node test/pricing-phase.mjs && node test/desktop-carrier.mjs && node test/client-smoke.mjs && node test/icon-geometry.mjs",
    "test:live": "node test/live-verify.mjs",
    "preview": "node tools/make-icon-preview.mjs && node tools/make-alignment-preview.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "balance",
    "monitor",
    "余额"
  ],
  "engines": {
    "node": ">=18"
  }
}
